{
  "name": "pgmaps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/ensure-vendor-json-url.mjs && npm run data:sync-from-bcdatamapper && node scripts/ensure-indigenous-data.mjs && node scripts/ensure-native-land-data.mjs",
    "dev": "vite",
    "prebuild": "npm --prefix vendor/json-url run build && npm run data:sync-from-bcdatamapper && node scripts/ensure-indigenous-data.mjs && node scripts/ensure-native-land-data.mjs",
    "build": "tsc -b && vite build && node scripts/write-spa-fallback.mjs",
    "data:sync-from-bcdatamapper": "node scripts/sync-bcdatamapper-data.mjs",
    "data:sync-from-bcdatamapper:clean": "node scripts/sync-bcdatamapper-data.mjs --clean",
    "preview": "vite preview",
    "citypg:sync": "npm --prefix vendor/bcdatamapper run citypg:sync --",
    "citypg:business-licences:sync": "npm --prefix vendor/bcdatamapper run citypg:business-licences:sync --",
    "citypg:heat-shade:sync": "npm --prefix vendor/bcdatamapper run citypg:heat-shade:sync --",
    "icbc:sync": "npm --prefix vendor/bcdatamapper run icbc:sync --",
    "heat-shade:sync": "npm --prefix vendor/bcdatamapper run heat-shade:sync --",
    "transit:gtfs:sync": "npm --prefix vendor/bcdatamapper run transit:gtfs:sync --",
    "watersheds:sync": "npm --prefix vendor/bcdatamapper run watersheds:sync --",
    "watersheds:dev": "npm --prefix vendor/bcdatamapper run watersheds:dev --",
    "nr-admin:sync": "npm --prefix vendor/bcdatamapper run nr-admin:sync --",
    "uwr:sync": "npm --prefix vendor/bcdatamapper run uwr:sync --",
    "indigenous:sync": "npm --prefix vendor/bcdatamapper run indigenous:sync --",
    "indigenous:copy": "npm --prefix vendor/bcdatamapper run indigenous:copy --",
    "bc:childcare:sync": "npm --prefix vendor/bcdatamapper run bc:childcare:sync --",
    "drought:sync": "npm --prefix vendor/bcdatamapper run drought:sync --",
    "drought:canonical": "npm --prefix vendor/bcdatamapper run drought:canonical --",
    "flood:sync": "npm --prefix vendor/bcdatamapper run flood:sync --",
    "crown-tenures:sync": "npm --prefix vendor/bcdatamapper run crown-tenures:sync --",
    "range-tenures:sync": "npm --prefix vendor/bcdatamapper run range-tenures:sync --",
    "mineral-tenures:sync": "npm --prefix vendor/bcdatamapper run mineral-tenures:sync --",
    "wars:sync": "npm --prefix vendor/bcdatamapper run wars:sync --",
    "cell-coverage:sync": "npm --prefix vendor/bcdatamapper run cell-coverage:sync --",
    "ev-charging:sync": "npm --prefix vendor/bcdatamapper run ev-charging:sync --",
    "network-availability:sync": "npm --prefix vendor/bcdatamapper run network-availability:sync --",
    "native-land:probe": "npm --prefix vendor/bcdatamapper run native-land:probe --",
    "native-land:geojson": "npm --prefix vendor/bcdatamapper run native-land:geojson --",
    "native-land:copy": "npm --prefix vendor/bcdatamapper run native-land:copy --",
    "cimd:sync": "npm --prefix vendor/bcdatamapper run cimd:sync --",
    "census:sync": "npm --prefix vendor/bcdatamapper run census:sync --",
    "census:variables": "npm --prefix vendor/bcdatamapper run census:variables --",
    "bc-assessment:build": "npm --prefix vendor/bcdatamapper run bc-assessment:build --",
    "bc-assessment:refresh": "npm --prefix vendor/bcdatamapper run bc-assessment:refresh --",
    "food-health:refresh": "npm --prefix vendor/bcdatamapper run food-health:refresh --",
    "food-health:geocode": "npm --prefix vendor/bcdatamapper run food-health:geocode --",
    "food-health:bc-geocoder-check": "npm --prefix vendor/bcdatamapper run food-health:bc-geocoder-check --",
    "healthyplan-pg:sync": "npm --prefix vendor/bcdatamapper run healthyplan-pg:sync --",
    "healthyplan-pg:sync:education": "npm --prefix vendor/bcdatamapper run healthyplan-pg:sync:education --",
    "healthyplan-pg:sync:citypg-business": "npm --prefix vendor/bcdatamapper run healthyplan-pg:sync:citypg-business --",
    "walkability:build": "npm --prefix vendor/bcdatamapper run walkability:build --",
    "walkability:import-supplements": "npm --prefix vendor/bcdatamapper run walkability:import-supplements --",
    "walkability:build-grid-heatmap": "npm --prefix vendor/bcdatamapper run walkability:build-grid-heatmap --",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@firstform/json-url": "file:vendor/json-url",
    "@firstform/spinnerwheel": "^1.3.1",
    "@mapbox/vector-tile": "^2.0.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-virtual": "^3.13.22",
    "@turf/turf": "^6.5.0",
    "@types/d3": "^7.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "d3": "^7.9.0",
    "dexie": "^4.4.3",
    "gsap": "^3.14.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jsts": "^2.12.1",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^5.15.0",
    "next-themes": "^0.4.6",
    "pbf": "^4.0.1",
    "pmtiles": "^4.4.1",
    "rbush": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "recharts": "^3.8.1",
    "shpjs": "^6.2.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.35",
    "prettier": "^3.8.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.3",
    "vitest": "^4.1.8"
  }
}
