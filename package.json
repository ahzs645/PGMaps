{
  "name": "pgmaps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm --prefix vendor/json-url run build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "citypg:sync": "node scripts/sync-citypg-arcgis.mjs",
    "icbc:sync": "node scripts/sync-icbc-tableau.mjs",
    "heat-shade:sync": "node scripts/sync-heat-shade-data.mjs",
    "transit:gtfs:sync": "node scripts/sync-transit-gtfs.mjs",
    "watersheds:sync": "node scripts/sync-bc-fwa-watersheds.mjs",
    "nr-admin:sync": "node scripts/sync-bc-nr-admin.mjs",
    "uwr:sync": "node scripts/sync-bc-uwr.mjs",
    "drought:sync": "node scripts/sync-bc-drought.mjs",
    "drought:canonical": "node scripts/build-bc-drought-canonical.mjs",
    "crown-tenures:sync": "node scripts/sync-bc-crown-tenures.mjs",
    "range-tenures:sync": "node scripts/sync-bc-range-tenures.mjs",
    "mineral-tenures:sync": "node scripts/sync-bc-mineral-tenures.mjs",
    "wars:sync": "python3 scripts/sync-bc-wars.py",
    "cimd:sync": "node scripts/sync-cimd.mjs",
    "canue:bc:sync": "node scripts/sync-canue-bc.mjs",
    "canue:bc:sync:all-years": "node scripts/sync-canue-bc.mjs --all-years true",
    "canue:bc:sync:all-cadences": "node scripts/sync-canue-bc.mjs --all-years true --cadence both",
    "canue:bc:sync:monthly": "node scripts/sync-canue-bc.mjs --all-years true --cadence monthly --gzip true",
    "canue:bc:membership": "node scripts/build-canue-postal-membership.mjs",
    "canue:bc:gzip": "node scripts/gzip-canue-csv.mjs",
    "canue:bc:boundaries": "node scripts/build-canue-boundary-aggregates.mjs",
    "census:sync": "node scripts/build-census-hierarchy.mjs",
    "census:variables": "python3 scripts/build-census-variables.py",
    "bc-assessment:build": "python3 scripts/build-bc-assessment.py",
    "bc-assessment:refresh": "python3 scripts/refresh-bc-assessment.py",
    "food-health:refresh": "python3 scripts/food-health/fetch_incremental.py --city \"Prince George\" --output public/data/restaurants.json --delay 5",
    "food-health:geocode": "python3 scripts/food-health/geocode_restaurants.py --file public/data/restaurants.json --delay 1.5",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "walkability:build": "node scripts/build-walkability-web.mjs",
    "walkability:import-supplements": "node scripts/import-walkability-supplements.mjs",
    "walkability:build-grid-heatmap": "node scripts/build-walkability-grid-heatmap.mjs"
  },
  "dependencies": {
    "@firstform/json-url": "file:vendor/json-url",
    "@firstform/spinnerwheel": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-virtual": "^3.13.22",
    "@turf/turf": "^6.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "gsap": "^3.14.2",
    "jsts": "^2.12.1",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^5.15.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.35",
    "prettier": "^3.8.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.3"
  }
}
