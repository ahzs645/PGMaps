{
  "name": "pgmaps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm --prefix vendor/json-url run build",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "citypg:sync": "node scripts/sync-citypg-arcgis.mjs",
    "heat-shade:sync": "node scripts/sync-heat-shade-data.mjs",
    "transit:gtfs:sync": "node scripts/sync-transit-gtfs.mjs",
    "cimd:sync": "node scripts/sync-cimd.mjs",
    "census:sync": "node scripts/build-census-hierarchy.mjs",
    "census:variables": "python3 scripts/build-census-variables.py",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@firstform/json-url": "file:vendor/json-url",
    "@firstform/spinnerwheel": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-virtual": "^3.13.22",
    "@turf/turf": "^6.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "gsap": "^3.14.2",
    "lucide-react": "^0.562.0",
    "maplibre-gl": "^5.15.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.0",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.56.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "postcss": "^8.4.35",
    "prettier": "^3.8.2",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.3"
  }
}
