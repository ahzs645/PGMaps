# Where the standalone road designer is deployed. These are defaults: override any of them for one
# deployment in `.env.production.local` (git-ignored) or in the build's environment, which wins over
# this file. PGMaps' own build never reads this file. Guide: docs/forestry-road-design/standalone-build.md

# The site path the build is served from: "/" at a domain's root, "/road-design/" under a subpath.
ROAD_DESIGN_BASE=/

# The designer's route below that base. The help is always at <base>help.
VITE_ROAD_DESIGN_PATH=/

# Where "Symbol gallery" goes (a route, an https URL), or empty to leave the link out.
VITE_ROAD_DESIGN_GALLERY_URL=https://pgmaps.ahmadjalil.com/dev/forestry/block-sheets

# Where the LiDAR sample terrain is read when this site holds no copy below <base>data/lidar-analysis/.
VITE_ROAD_DESIGN_LIDAR_MIRROR=https://pgmaps.ahmadjalil.com/data/lidar-analysis/bc-093g086/

# "false" hides the plan's Esri Wayback historical imagery timeline; unset or "true" offers it.
VITE_ROAD_DESIGN_WAYBACK_TIMELINE=true

# The data folders the designer reads from another site (docs/data-hosts.md): the build ships no data/.
VITE_DATA_HOSTS={"hosts":[{"name":"pgmaps","baseUrl":"https://pgmaps.ahmadjalil.com/data","folders":["boundaries/BCNR"]}]}
