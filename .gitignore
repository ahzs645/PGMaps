.eslintcache

# Testing
coverage
playwright-report
test-results

# Generated census variable data (built from scripts/build-census-variables.py)
public/data/census/variables/

# Generated BC Assessment data (built from scripts/build-bc-assessment.py)
public/data/bc-assessment/

# Walkability factor masks are generated but committed app-ready assets.
!public/data/walkability/heatmap/factor_masks.json

# Generated CANUE source extracts stay local; commit compressed app-ready outputs instead.
public/data/canue/bc/annual/*.csv
public/data/canue/bc/parquet-experiment/

# HealthSpace scraper debug output
healthspace_response.html
healthspace_debug.html

# Generated source inventories can exceed GitHub's blob size limits.
data-sources/drivebc/historical/schema-inventory.json

# Generated Indigenous support layers can be large; rebuild with npm run indigenous:sync.
public/data/indigenous/

# Native Land Digital probe/API extracts are generated locally; the app uses the
# bundled bcdatamapper snapshot copied into public/data/native-land/.
data-sources/native-land/

# Generated from the bcdatamapper Native Land snapshot for local app use.
public/data/native-land/

# Generated from the bcdatamapper ECCC forecast-zone snapshot for local app use.
public/data/aqmap/

# Generated from the bcdatamapper network-availability snapshot for local app use.
public/data/network-availability/
