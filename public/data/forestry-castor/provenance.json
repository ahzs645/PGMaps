  "observations": [
    "The sample has 10,000 100m cells (one hectare per cell), one yield curve with 26 age knots from 0 through 250, and one management zone.",
    "All initial pixel volumes are NULL; all initial heights are 10. Growth initialization must be an explicit part of preparation.",
    "The sample has no blocks, adjacentBlocks, harvestFlow, or calibration model/data tables and no pixel blockid field.",
    "The sample uses an older transitions schema (silvsystem_from/silvsystem_to) than current dataCastor.createCastorDB.",
    "The single age>=140 constraint has percentage=0 and therefore reserves no cells by itself.",
    "The supplied projected grid location is preserved. It does not establish that the illustrative ages/attributes represent that location."
  ],
  "browserPreparationDecisions": [
    "Generate or import harvest units explicitly; per-cell units are a browser preparation choice, not upstream blocked results.",
    "Specify harvest demand, period length and planning horizon; these are not in the source database.",
    "Review the treatment and yield transitions; never infer a missing treatment intensity or calibration.",
    "Record browser endpoint interpolation and other model changes in scenario provenance."
  ],
  "tutorialFlowExample": {
    "source": "https://github.com/bcgov/forestryCastor/blob/e2a580eb1fcc634780bb3599da7265a1e871484f/forestryCastor.Rmd",
    "compartment": "all",
    "partition": "vol > 110",
    "partition_type": "live",
    "periods": [
      1,
      2
    ],
    "flowM3PerPeriod": 220000,
    "periodYears": 5,
    "note": "Example from the separate random-landscape tutorial, not a prescribed or validated flow for the SQLite sample."
  }
