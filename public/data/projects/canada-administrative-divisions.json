  "scenes": [
    {
      "label": "The national question",
      "kicker": "01 · Start here",
      "title": "There is no single Canadian ‘second level’",
      "text": "Counties, regional districts, regional municipalities, service commissions, census divisions, territories, and regions all appear at roughly the same map scale. They do not all have the same powers—and some exist only for statistical comparison.",
      "focus": "Canada · current regional parent geography",
      "visibleLayerIds": [
        "regional-2025"
      ],
      "legend": [
        {
          "label": "Regional government or statistical equivalent",
          "color": "#7c3aed"
        }
      ],
