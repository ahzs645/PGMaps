  "actions": {
    "select-cariboo": {
      "type": "select-category",
      "categoryId": "5950"
    },
    "clear": {
      "type": "select-category",
      "categoryId": null
    },
    "zoom-cariboo": {
      "type": "set-map-view",
      "targetId": "region-sidecar",
      "viewId": "cariboo"
    },
    "jump-diagrams": {
      "type": "go-to-chapter",
      "chapterId": "diagrams-chapter"
    }
  },
  "chapters": [
    {
      "id": "start-chapter",
      "title": "A story built from blocks",
      "blocks": [
        {
          "id": "intro",
          "type": "paragraph",
          "text": [
            "The presentation comes from reusable blocks. The boundaries are real 2021 economic regions; the illustrations and dot arrangement are teaching examples."
          ]
        },
        {
          "id": "opening-quote",
          "type": "quote",
          "text": [
            "Content, geography and presentation can change independently."
          ]
        },
        {
          "id": "outline-list",
          "type": "list",
          "items": [
            [
              "Scroll through map views."
            ],
            [
              "Choose a category in a map or diagram."
            ],
            [
              "Reuse the same JSON contract in another project."
            ]
          ]
        },
        {
          "id": "opening-image",
          "type": "image",
          "src": "/data/story-documents/native-example/connections.svg",
          "alt": "Connections through categories",
          "caption": "Connections through categories",
          "credit": "PGMaps · illustrative graphic",
          "expandable": true
        },
        {
          "id": "first-break",
          "type": "separator"
        }
      ]
    },
    {
      "id": "map-chapter",
      "title": "One map, several views",
      "blocks": [
        {
          "id": "region-sidecar",
          "type": "sidecar",
          "presentation": "docked",
          "side": "left",
          "steps": [
            {
              "id": "province-step",
              "content": [
                {
                  "id": "province-copy",
                  "type": "paragraph",
                  "text": [
                    "These eight regions cover British Columbia. ",
                    {
                      "text": "Select Cariboo",
                      "actionId": "select-cariboo"
                    },
                    " or ",
                    {
                      "text": "zoom closer",
                      "actionId": "zoom-cariboo"
                    },
                    "."
                  ]
                }
              ],
              "media": {
                "type": "map",
                "mapId": "regions",
                "viewId": "province"
              }
            },
            {
              "id": "cariboo-step",
              "content": [
                {
                  "id": "cariboo-copy",
                  "type": "paragraph",
                  "text": [
                    "The map keeps its canvas as this chapter changes views. ",
                    {
                      "text": "Clear selection",
                      "actionId": "clear"
                    },
                    "."
                  ]
                }
              ],
              "media": {
                "type": "map",
                "mapId": "regions",
                "viewId": "cariboo"
              }
            },
            {
              "id": "coast-step",
              "content": [
                {
                  "id": "coast-copy",
                  "type": "paragraph",
                  "text": [
                    "The same source supports another view along the coast. ",
                    {
                      "text": "Continue to diagrams",
                      "actionId": "jump-diagrams"
                    },
                    "."
                  ]
                }
              ],
              "media": {
                "type": "map",
                "mapId": "regions",
                "viewId": "coast"
              }
            }
          ]
        },
        {
          "id": "map-reveal",
          "type": "comparison",
          "mapId": "regions",
          "leftViewId": "province",
          "rightViewId": "outline",
          "leftLabel": "Filled regions",
          "rightLabel": "Boundary outlines"
        }
      ]
    },
    {
      "id": "diagrams-chapter",
      "title": "Categories that connect",
      "blocks": [
        {
          "id": "diagram-intro",
          "type": "paragraph",
          "text": [
            "Select a category using the hierarchy list. That selection is shared by every map and diagram in this story."
          ]
        },
        {
          "id": "hierarchy-block",
          "type": "diagram",
          "diagramId": "taxonomy"
        },
        {
          "id": "linked-map",
          "type": "map",
          "mapId": "regions",
          "viewId": "province"
        },
        {
          "id": "dot-sidecar",
          "type": "sidecar",
          "presentation": "floating",
          "side": "center",
          "width": "large",
          "steps": [
            {
              "id": "dot-step-all",
              "content": [
                {
                  "id": "dot-copy-all",
                  "type": "paragraph",
                  "text": [
                    "All points keep stable positions as you scroll."
                  ]
                }
              ],
              "media": {
                "type": "diagram",
                "diagramId": "dots",
                "stepId": "all"
              }
            },
            {
              "id": "dot-step-sample",
              "content": [
                {
                  "id": "dot-copy-sample",
                  "type": "paragraph",
                  "text": [
                    "This circle selects a sample without moving any dots."
                  ]
                }
              ],
              "media": {
                "type": "diagram",
                "diagramId": "dots",
                "stepId": "sample"
              }
            },
            {
              "id": "dot-step-cariboo",
              "content": [
                {
                  "id": "dot-copy-cariboo",
                  "type": "paragraph",
                  "text": [
                    "This step isolates one category. Counts describe this illustration only."
                  ]
                }
              ],
              "media": {
                "type": "diagram",
                "diagramId": "dots",
                "stepId": "cariboo"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tour-chapter",
      "title": "A guided journey",
      "blocks": [
        {
          "id": "regional-tour",
          "type": "tour",
          "mapId": "regions",
          "stops": [
            {
              "id": "tour-cariboo",
              "label": "Cariboo",
              "coordinates": [
                -122.7,
