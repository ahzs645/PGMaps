+    const rock = vec3(0.4, 0.39, 0.36).mul(n3.mul(0.3).add(0.8));
+    const cutCol = mix(vec3(0.44, 0.33, 0.21).mul(n2.mul(0.25).add(0.85)), rock, smoothstep(0.4, 0.7, mx_noise_float(p.mul(0.9)).mul(0.5).add(0.5)));
