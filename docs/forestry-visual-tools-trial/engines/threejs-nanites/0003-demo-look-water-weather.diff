--- /dev/null
+++ b/examples/pgmaps/terrain.ts
@@ -0,0 +1,172 @@
+// The package's ground as a mesh (its grid, gaps filled from their nearest known neighbours, and an apron out to the
+// fog so the grid's edge never shows), and the ground's masks near the stand: canopy cover from the stems' crowns, the
+// openings (cut blocks) and the road's cut and fill slopes, rasterized into one texture the floor reads (floor.ts).
+import * as THREE from 'three/webgpu';
+import type { Ring, ScenePackage } from './package.ts';
+
+/** How far the apron reaches past the grid (m), in rings of these distances from its edge. */
+const APRON = [250, 700, 1600, 3500, 8000, 16000];
+
+export interface Terrain {
+  mesh: THREE.Mesh;
+  /** The ground's height at three's x, z (north is -z). */
+  heightAt: (x: number, z: number) => number;
+  /** The package grid's extent (package metres). */
+  bounds: { west: number; south: number; east: number; north: number };
+  /** Each of the package's water bodies' surface (m), in the package's order (the ground under them is lowered). */
+  waterLevels: number[];
+}
+
+export function buildTerrain(scene: ScenePackage): Terrain {
+  const { west, south, spacing, columns, rows } = scene.terrain;
+  const h = scene.terrain.heights.slice();
+  const fill = (index: (i: number, j: number) => number, outer: number, inner: number): void => {
+    for (let i = 0; i < outer; i++) {
+      let last: number | null = null;
+      for (let j = 0; j < inner; j++) last = h[index(i, j)] ?? last;
+      for (let j = inner - 1; j >= 0; j--) {
+        const k = index(i, j);
+        if (h[k] === null) h[k] = last;
+        else last = h[k];
+      }
+    }
+  };
+  fill((r, c) => r * columns + c, rows, columns);
+  fill((c, r) => r * columns + c, columns, rows);
+  const known = h.filter((v): v is number => v !== null);
+  const mean = known.reduce((s, v) => s + v, 0) / Math.max(1, known.length);
+  const at = (c: number, r: number): number => h[r * columns + c] ?? mean;
+  /** Package x (east), y (north). Past the grid: its edge's height, easing to the grid's mean far out. */
+  const heightNE = (x: number, y: number): number => {
+    const gx = (x - west) / spacing, gy = (y - south) / spacing;
+    const cx = Math.min(columns - 1.0001, Math.max(0, gx)), cy = Math.min(rows - 1.0001, Math.max(0, gy));
+    const x0 = Math.floor(cx), y0 = Math.floor(cy), fx = cx - x0, fy = cy - y0;
+    const v = at(x0, y0) * (1 - fx) * (1 - fy) + at(x0 + 1, y0) * fx * (1 - fy) + at(x0, y0 + 1) * (1 - fx) * fy + at(x0 + 1, y0 + 1) * fx * fy;
+    const out = Math.max(Math.abs(gx - cx), Math.abs(gy - cy)) * spacing;
+    return out > 0 ? v + (mean - v) * Math.min(1, out / 9000) : v;
+  };
+  // the water's levels (none given: the lowest ground on its outer ring), then the ground under it lowered to a bed
+  // below that level, so a surface on sloping ground isn't buried in it
+  const water = (scene.water ?? []).filter((w) => Array.isArray(w?.rings) && w.rings[0]?.length >= 3);
+  const waterLevels = water.map((w) => w.elevationMeters ?? Math.min(...w.rings[0].map(([x, y]) => heightNE(x, y))));
+  water.forEach((w, k) => {
+    const [outer, ...holes] = w.rings;
+    const xs0 = outer.map((p) => p[0]), ys0 = outer.map((p) => p[1]);
+    const c0 = Math.max(0, Math.floor((Math.min(...xs0) - west) / spacing)), c1 = Math.min(columns - 1, Math.ceil((Math.max(...xs0) - west) / spacing));
+    const r0 = Math.max(0, Math.floor((Math.min(...ys0) - south) / spacing)), r1 = Math.min(rows - 1, Math.ceil((Math.max(...ys0) - south) / spacing));
+    for (let r = r0; r <= r1; r++)
+      for (let c = c0; c <= c1; c++) {
+        const x = west + c * spacing, y = south + r * spacing;
+        if (!inRing(x, y, outer) || holes.some((hole) => inRing(x, y, hole))) continue;
+        h[r * columns + c] = Math.min(at(c, r), waterLevels[k] - 2);
+      }
+  });
+  const east = west + (columns - 1) * spacing, north = south + (rows - 1) * spacing;
+  // the grid's own vertices, then the apron's rings on each side
+  const xs = [...APRON.slice().reverse().map((d) => west - d), ...Array.from({ length: columns }, (_, i) => west + i * spacing), ...APRON.map((d) => east + d)];
+  const ys = [...APRON.slice().reverse().map((d) => south - d), ...Array.from({ length: rows }, (_, i) => south + i * spacing), ...APRON.map((d) => north + d)];
+  const nx = xs.length, ny = ys.length;
+  const pos = new Float32Array(nx * ny * 3);
+  for (let j = 0; j < ny; j++) for (let i = 0; i < nx; i++) pos.set([xs[i], heightNE(xs[i], ys[j]), -ys[j]], (j * nx + i) * 3);
+  const idx = new Uint32Array((nx - 1) * (ny - 1) * 6);
+  let k = 0;
+  for (let j = 0; j < ny - 1; j++)
+    for (let i = 0; i < nx - 1; i++) {
+      const a = j * nx + i, b = a + 1, c = a + nx, d = c + 1;
+      // (north is -z: counter-clockwise seen from above)
+      idx.set([a, b, c, b, d, c], k);
+      k += 6;
+    }
+  const geometry = new THREE.BufferGeometry();
+  geometry.setAttribute('position', new THREE.BufferAttribute(pos, 3));
+  geometry.setIndex(new THREE.BufferAttribute(idx, 1));
+  geometry.computeVertexNormals();
+  geometry.computeBoundingSphere();
+  const mesh = new THREE.Mesh(geometry);
+  mesh.receiveShadow = true;
+  mesh.frustumCulled = false;
+  return { mesh, heightAt: (x, z) => heightNE(x, -z), bounds: { west, south, east, north }, waterLevels };
+}
+
+/** Whether package (x, y) is inside a ring (even-odd). */
+function inRing(x: number, y: number, ring: Ring): boolean {
+  let inside = false;
+  for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
+    const [xi, yi] = ring[i], [xj, yj] = ring[j];
+    if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) inside = !inside;
+  }
+  return inside;
+}
+
+export interface GroundMasks {
+  /** r canopy cover, g opening, b road cut, a road fill (0..1), north at the top row. */
+  texture: THREE.DataTexture;
+  /** The square it covers (package metres): its west and north edges and side. */
+  west: number;
+  north: number;
+  side: number;
+}
+
+/**
+ * The masks over the stems, openings and road scars (a square, at most 2048 texels a side, 0.5 m texels or coarser).
+ * The crowns' cover is each stem's crown as a disc.
+ */
+export function buildMasks(scene: ScenePackage, bounds: Terrain['bounds']): GroundMasks {
+  let x0 = Infinity, x1 = -Infinity, y0 = Infinity, y1 = -Infinity;
+  const add = (x: number, y: number, r = 0): void => {
+    (x0 = Math.min(x0, x - r)), (x1 = Math.max(x1, x + r)), (y0 = Math.min(y0, y - r)), (y1 = Math.max(y1, y + r));
+  };
+  const { fields, data, count } = scene.trees;
+  const st = fields.length, fx = fields.indexOf('x'), fy = fields.indexOf('y'), fw = fields.indexOf('crownWidth'), fh = fields.indexOf('height');
+  for (let i = 0; i < count; i++) add(data[i * st + fx], data[i * st + fy], 20);
+  const rings: Ring[] = [];
+  for (const o of scene.openings ?? []) rings.push(...o.rings);
+  for (const s of scene.roadScars ?? []) rings.push(s.ring);
+  for (const r of rings) for (const [x, y] of r) add(x, y, 10);
+  if (!Number.isFinite(x0)) add(0, 0, 100);
+  (x0 = Math.max(x0, bounds.west)), (x1 = Math.min(x1, bounds.east)), (y0 = Math.max(y0, bounds.south)), (y1 = Math.min(y1, bounds.north));
+  const side = Math.max(x1 - x0, y1 - y0, 50);
+  const N = Math.min(2048, Math.max(64, Math.ceil(side / 0.5)));
+  const texel = side / N;
+  const canvas = (draw: (g: OffscreenCanvasRenderingContext2D) => void): Uint8ClampedArray => {
+    const c = new OffscreenCanvas(N, N), g = c.getContext('2d')!;
+    g.setTransform(1 / texel, 0, 0, -1 / texel, -x0 / texel, (y0 + side) / texel); // (package metres; north up)
+    g.fillStyle = '#fff';
+    draw(g);
+    // (softened by about a metre: the floor's noise makes the edge ragged)
+    const soft = new OffscreenCanvas(N, N), s = soft.getContext('2d', { willReadFrequently: true })!;
+    s.filter = `blur(${Math.max(0.6, 1 / texel).toFixed(2)}px)`;
+    s.drawImage(c, 0, 0);
+    return s.getImageData(0, 0, N, N).data;
+  };
+  const polygon = (g: OffscreenCanvasRenderingContext2D, rs: Ring[]): void => {
+    g.beginPath();
+    for (const r of rs) r.forEach(([x, y], i) => (i ? g.lineTo(x, y) : g.moveTo(x, y)));
+    g.fill('evenodd');
+  };
+  const cover = canvas((g) => {
+    for (let i = 0; i < count; i++) {
+      const o = i * st, w = fw >= 0 ? data[o + fw] : (fh >= 0 ? data[o + fh] * 0.25 : 4);
+      g.beginPath();
+      g.arc(data[o + fx], data[o + fy], Math.max(0.8, w * 0.55), 0, Math.PI * 2);
+      g.fill();
+    }
+  });
+  const open = canvas((g) => (scene.openings ?? []).forEach((o) => polygon(g, o.rings)));
+  const cut = canvas((g) => (scene.roadScars ?? []).filter((s) => s.kind === 'cut').forEach((s) => polygon(g, [s.ring])));
+  const fillMask = canvas((g) => (scene.roadScars ?? []).filter((s) => s.kind !== 'cut').forEach((s) => polygon(g, [s.ring])));
+  const px = new Uint8Array(N * N * 4);
+  for (let i = 0; i < N * N; i++) {
+    px[i * 4] = cover[i * 4];
+    px[i * 4 + 1] = open[i * 4];
+    px[i * 4 + 2] = cut[i * 4];
+    px[i * 4 + 3] = fillMask[i * 4];
+  }
+  const texture = new THREE.DataTexture(px, N, N);
+  texture.magFilter = THREE.LinearFilter;
+  texture.minFilter = THREE.LinearMipmapLinearFilter;
+  texture.generateMipmaps = true;
+  texture.wrapS = texture.wrapT = THREE.ClampToEdgeWrapping;
+  texture.needsUpdate = true;
+  return { texture, west: x0, north: y0 + side, side };
+}
diff --git a/examples/pgmaps/tree-worker.ts b/examples/pgmaps/tree-worker.ts
new file mode 100644
index 0000000..0eded3f
--- /dev/null
+++ b/examples/pgmaps/tree-worker.ts
@@ -0,0 +1,114 @@
+// One tree type of a PGMaps package, off the main thread: an ez-tree grown from its species' preset (species.ts),
+// its branch lengths tuned until its crown is the width class's share of its height, the last few percent taken up
+// by scaling it across, then its cluster DAG (the library's buildDag) with the leaf texture's mask.
+import { Tree, Billboard } from '@dgreenheck/ez-tree';
+// (straight from the module, not the library's index: a worker's bundle takes only what it imports)
+import { buildDag } from '../../src/nanite-lib/dag/build.ts';
+import type { BarkSource, DagResult, LeafMask, LeafSource } from '../../src/nanite-lib/dag/types.ts';
+import { mergeOptions, type SpeciesLook } from './species.ts';
+
+export interface GrowJob {
+  id: number;
+  look: SpeciesLook;
+  seed: number;
+  /** Height the model is built at (m); stems scale it to their own. */
+  height: number;
+  /** Crown width / height to reach. */
+  ratio: number;
+  /** Where the live crown starts (share of the height), or null for the preset's. */
+  crownBase: number | null;
+  leafMask: LeafMask | null;
+}
+export type GrowReply =
+  | (DagResult & { src: { bark: BarkSource; leaves: LeafSource }; radius: number; height: number; grown: number; squash: number; ms: number })
+  | { id: number; error: string };
+
+type Options = { seed: number; branch: { length: Record<number, number>; start: Record<number, number> }; leaves: { billboard: string }; bark: { textureScale: { x: number; y: number } } };
+type Grown = { branches: { verts: number[]; normals: number[]; uvs: number[]; indices: number[] }; leaves: { verts: number[]; normals: number[]; uvs: number[] } };
+
+/** Crown width / height of a grown tree: twice the 95th percentile of its leaves' distance from the trunk, over its top. */
+function measure(t: Grown): { ratio: number; top: number } {
+  let top = 0;
+  for (const v of [t.branches.verts, t.leaves.verts]) for (let i = 1; i < v.length; i += 3) top = Math.max(top, v[i]);
+  const from = t.leaves.verts.length ? t.leaves.verts : t.branches.verts;
+  const r: number[] = [];
+  for (let i = 0; i < from.length; i += 3) r.push(Math.hypot(from[i], from[i + 2]));
+  r.sort((a, b) => a - b);
+  return { ratio: (2 * (r[Math.floor(r.length * 0.95)] ?? 0)) / Math.max(top, 1e-6), top };
+}
+
+function grow(job: GrowJob) {
+  const tree = new Tree();
+  tree.loadPreset(job.look.preset);
+  const o = tree.options as unknown as Options;
+  mergeOptions(o as unknown as Record<string, unknown>, job.look.options);
+  o.seed = job.seed;
+  if (job.crownBase !== null) o.branch.start[1] = Math.min(0.8, Math.max(0.05, job.crownBase));
+  // the crown's width by its branches' length: a few rounds towards the ratio (ez-tree's growth isn't linear in it)
+  const base = { ...o.branch.length };
+  const keys = job.look.conifer ? [1] : [1, 2];
+  let k = 1, m = { ratio: 1, top: 1 };
+  for (let round = 0; round < 3; round++) {
+    for (const key of keys) o.branch.length[key] = base[key] * k;
+    tree.generate();
+    m = measure(tree as unknown as Grown);
+    if (Math.abs(m.ratio / job.ratio - 1) < 0.04) break;
+    k = Math.min(4, Math.max(0.2, k * (job.ratio / Math.max(m.ratio, 1e-3)) ** (job.look.conifer ? 1 : 1.25)));
+  }
+  const grown = m.ratio;
+  const squash = job.ratio / Math.max(grown, 1e-3); // (the rest: the tree scaled across)
+  const s = job.height / m.top;
+  const t = tree as unknown as Grown;
+  const tex = o.bark.textureScale;
+  const bark: BarkSource = {
+    pos: Float32Array.from(t.branches.verts, (v, i) => v * s * (i % 3 === 1 ? 1 : squash)),
+    nrm: new Float32Array(t.branches.normals.length),
+    uv: Float32Array.from(t.branches.uvs, (v, i) => (i % 2 === 0 ? v * tex.x : v / tex.y)),
+    idx: Uint32Array.from(t.branches.indices),
+  };
+  // (normals of a mesh scaled across: divided by the scale, renormalized)
+  for (let i = 0; i < bark.nrm.length; i += 3) {
+    const x = t.branches.normals[i] / squash, y = t.branches.normals[i + 1], z = t.branches.normals[i + 2] / squash;
+    const l = Math.hypot(x, y, z) || 1;
+    bark.nrm.set([x / l, y / l, z / l], i);
+  }
+  // Leaf normals as the demo's (src/tree-grow.ts): the card's blended with the way out of the crown, so the crown
+  // shades as a volume rather than as flat cards.
+  const lpos = Float32Array.from(t.leaves.verts, (v, i) => v * s * (i % 3 === 1 ? 1 : squash));
+  const n = lpos.length / 3;
+  let cx = 0, cy = 0, cz = 0;
+  for (let i = 0; i < n; i++) (cx += lpos[i * 3]), (cy += lpos[i * 3 + 1]), (cz += lpos[i * 3 + 2]);
+  (cx /= n || 1), (cy /= n || 1), (cz /= n || 1);
+  const lnrm = new Float32Array(n * 3);
+  for (let i = 0; i < n; i++) {
+    let x = lpos[i * 3] - cx, y = (lpos[i * 3 + 1] - cy) * 1.4 + 0.3 * job.height, z = lpos[i * 3 + 2] - cz;
+    const len = Math.hypot(x, y, z) || 1;
+    (x /= len), (y /= len), (z /= len);
+    let nx = t.leaves.normals[i * 3] ?? 0, ny = t.leaves.normals[i * 3 + 1] ?? 1, nz = t.leaves.normals[i * 3 + 2] ?? 0;
+    if (nx * x + ny * y + nz * z < 0) (nx = -nx), (ny = -ny), (nz = -nz);
+    const mx = x * 0.8 + nx * 0.2, my = y * 0.8 + ny * 0.2, mz = z * 0.8 + nz * 0.2;
+    const ml = Math.hypot(mx, my, mz) || 1;
+    lnrm.set([mx / ml, my / ml, mz / ml], i * 3);
+  }
+  const leaves: LeafSource = { pos: lpos, nrm: lnrm, uv: Float32Array.from(t.leaves.uvs), vpl: o.leaves.billboard === Billboard.Double ? 8 : 4 };
+  let radius = 0;
+  for (const p of [bark.pos, lpos]) for (let i = 0; i < p.length; i += 3) radius = Math.max(radius, Math.hypot(p[i], p[i + 1] - job.height / 2, p[i + 2]));
+  return { bark, leaves, radius, grown, squash };
+}
+
+const scope = self as unknown as { onmessage: (e: MessageEvent<GrowJob>) => void; postMessage(msg: GrowReply, transfer?: Transferable[]): void };
+scope.onmessage = async (e) => {
+  const job = e.data;
+  try {
+    const t0 = performance.now();
+    const g = grow(job);
+    const r = await buildDag({ id: job.id, bark: structuredClone(g.bark), leaves: structuredClone(g.leaves), ...(job.leafMask ? { leafMask: job.leafMask } : {}) });
+    const { bark, leaves } = g;
+    scope.postMessage(
+      { ...r, src: { bark, leaves }, radius: g.radius, height: job.height, grown: g.grown, squash: g.squash, ms: performance.now() - t0 },
+      [r.vtx.buffer, r.idx.buffer, r.rec.buffer, r.meta.buffer, bark.pos.buffer, bark.nrm.buffer, bark.uv.buffer, bark.idx.buffer, leaves.pos.buffer, leaves.nrm.buffer, leaves.uv.buffer],
+    );
+  } catch (err) {
+    scope.postMessage({ id: job.id, error: String(err instanceof Error ? (err.stack ?? err) : err) });
+  }
+};
diff --git a/examples/pgmaps/trees.ts b/examples/pgmaps/trees.ts
new file mode 100644
index 0000000..8b91979
--- /dev/null
+++ b/examples/pgmaps/trees.ts
@@ -0,0 +1,142 @@
+// A package's stems as Nanite types and instances: per species, its stems' crown width / height ratios binned into
+// width classes (species.ts), one ez-tree type grown per (species, class) in a worker (tree-worker.ts), each stem an
+// instance of its class's type at its own height. The demo's bark and leaf images (public/textures), tinted per
+// species, are the texture arrays. Grown types and loaded images are kept for the page's later packages.
+import * as THREE from 'three/webgpu';
+import { loadLayer, arrayTexture, layerLookup } from '../../src/textures.ts';
+import type { LayerData } from '../../src/texture-pixels.ts';
+import { LEAF_DITHER, type NaniteType, type NaniteTextures } from '../../src/nanite-lib/index.ts';
+import { lookOf, widthClasses, type BarkImage, type LeafImage } from './species.ts';
+import type { GrowJob, GrowReply } from './tree-worker.ts';
+import type { ScenePackage } from './package.ts';
+
+/** Each model is built this tall and scaled to its stem's height. */
+export const MODEL_HEIGHT = 20;
+const TEX = 1024;
+
+const images = new Map<string, Promise<LayerData>>();
+const image = (url: string, leaf: boolean): Promise<LayerData> => {
+  let p = images.get(url);
+  if (!p) images.set(url, (p = loadLayer(url, TEX, leaf)));
+  return p;
+};
+/** A bark image's texels (the debris' logs take it too). */
+export const barkImage = (b: BarkImage) => image(`../textures/${b}_color_1k.jpg`, false);
+const leafImage = (l: LeafImage) => image(`../textures/${l}_color.png`, true);
+
+/** A copy of a layer with its sRGB bytes scaled (the alpha, its scales and mask kept). */
+function tinted(l: LayerData, [r, g, b]: [number, number, number]): LayerData {
+  const px = new Uint8ClampedArray(l.px);
+  for (let i = 0; i < px.length; i += 4) (px[i] *= r), (px[i + 1] *= g), (px[i + 2] *= b);
+  return { px, alphaScales: l.alphaScales, mask: l.mask };
+}
+
+const grown = new Map<string, Promise<GrowReply>>();
+function growType(job: Omit<GrowJob, 'id'>, id: number): Promise<GrowReply> {
+  const key = JSON.stringify({ ...job, leafMask: null });
+  let p = grown.get(key);
+  if (!p) {
+    p = new Promise<GrowReply>((resolve, reject) => {
+      const w = new Worker(new URL('./tree-worker.ts', import.meta.url), { type: 'module' });
+      w.onmessage = (e: MessageEvent<GrowReply>) => (w.terminate(), resolve(e.data));
+      w.onerror = (e) => (w.terminate(), reject(new Error(`tree worker: ${e.message}`)));
+      w.postMessage({ ...job, id } satisfies GrowJob);
+    });
+    grown.set(key, p);
+    p.then((r) => 'error' in r && grown.delete(key), () => grown.delete(key));
+  }
+  return p;
+}
+
+export interface Stand {
+  types: NaniteType[];
+  instances: { a: Float32Array; b: Float32Array };
+  textures: NaniteTextures;
+  barkLayers: number[];
+  leafLayers: number[];
+  /** Mean and 90th percentile of |stem crown width / drawn crown width - 1|, and the classes' log. */
+  residual: { mean: number; p90: number; lines: string[] };
+  growMs: number;
+}
+
+export async function buildStand(scene: ScenePackage, samples: number): Promise<Stand> {
+  const t0 = performance.now();
+  const { fields, data, count } = scene.trees;
+  const stride = fields.length;
+  const F = Object.fromEntries(['x', 'y', 'z', 'species', 'height', 'crownWidth', 'tone'].map((k) => [k, fields.indexOf(k)]));
+  if (F.x < 0 || F.y < 0 || F.z < 0 || F.species < 0 || F.height < 0) throw new Error('The package\'s trees lack x, y, z, species or height.');
+  // the species in use, and each one's stems
+  const stemsOf = new Map<number, number[]>();
+  for (let i = 0; i < count; i++) {
+    const sp = data[i * stride + F.species];
+    if (!stemsOf.has(sp)) stemsOf.set(sp, []);
+    stemsOf.get(sp)!.push(i);
+  }
+  const used = [...stemsOf.keys()].sort((x, y) => x - y);
+  const names = used.map((i) => scene.trees.species[i] ?? 'spruce');
+  const jobs: { job: Omit<GrowJob, 'id'>; species: number; layer: number }[] = [];
+  const typeOf = new Int32Array(count);
+  const errors: number[] = [];
+  const lines: string[] = [];
+  for (const [layer, sp] of used.entries()) {
+    const name = names[layer], look = lookOf(name), info = scene.species?.[name];
+    const stems = stemsOf.get(sp)!;
+    const ratioOf = (i: number): number => {
+      const o = i * stride, w = F.crownWidth >= 0 ? data[o + F.crownWidth] : NaN;
+      return Number.isFinite(w) && w > 0 ? w / Math.max(1, data[o + F.height]) : (info?.crownRatio ?? 0.25);
+    };
+    const ratios = stems.map(ratioOf);
+    const { centres, classOf } = widthClasses(ratios);
+    const mask = (await leafImage(look.leaf)).mask;
+    const first = jobs.length;
+    centres.forEach((ratio, c) => jobs.push({
+      job: { look, seed: look.seed + c * 17, height: MODEL_HEIGHT, ratio: Math.min(1.2, Math.max(0.08, ratio)), crownBase: info?.crownBase ?? null, leafMask: mask },
+      species: sp, layer,
+    }));
+    stems.forEach((i, k) => {
+      typeOf[i] = first + classOf[k];
+      errors.push(Math.abs(ratios[k] / centres[classOf[k]] - 1));
+    });
+    lines.push(`${name}: ${stems.length} stems, crown/height classes ${centres.map((c) => c.toFixed(2)).join(' / ')}`);
+  }
+  const replies = await Promise.all(jobs.map(({ job }, id) => growType(job, id)));
+  const types: NaniteType[] = replies.map((r, id) => {
+    if ('error' in r) throw new Error(`growing ${names[jobs[id].layer]}: ${r.error}`);
+    const { src, radius, height } = r;
+    return { ...r, id, name: `${names[jobs[id].layer]}-${id}`, radius, height, src };
+  });
+  replies.forEach((r, id) => {
+    if (!('error' in r)) lines.push(`  type ${id}: ratio ${jobs[id].job.ratio.toFixed(2)} grown ${r.grown.toFixed(2)} (x${r.squash.toFixed(2)} across), ${(r.idx.length / 3).toLocaleString()} tris, ${Math.round(r.ms)} ms`);
+  });
+
+  // the instances, in type order: a = (x, y, z, scale), b = (cos, sin, type, tone)
+  const order = Array.from({ length: count }, (_, i) => i).sort((x, y) => typeOf[x] - typeOf[y]);
+  const a = new Float32Array(count * 4), b = new Float32Array(count * 4);
+  order.forEach((i, k) => {
+    const o = i * stride;
+    // (a yaw from the position: the package's stems carry none)
+    const yaw = (Math.sin(data[o + F.x] * 12.9898 + data[o + F.y] * 78.233) * 43758.5453) % 1 * Math.PI * 2;
+    const tone = F.tone >= 0 ? data[o + F.tone] : 0.5;
+    a.set([data[o + F.x], data[o + F.z], -data[o + F.y], data[o + F.height] / MODEL_HEIGHT], k * 4);
+    b.set([Math.cos(yaw), Math.sin(yaw), typeOf[i], Number.isFinite(tone) ? tone : 0.5], k * 4);
+  });
+
+  // texture arrays: a bark and a leaf layer per species, tinted
+  const barkTex = await arrayTexture(names.map(async (n) => tinted(await barkImage(lookOf(n).bark), lookOf(n).barkTint)), TEX);
+  const leafTex = await arrayTexture(names.map(async (n) => tinted(await leafImage(lookOf(n).leaf), lookOf(n).leafTint)), TEX);
+  barkTex.colorSpace = leafTex.colorSpace = THREE.SRGBColorSpace;
+  leafTex.wrapS = leafTex.wrapT = THREE.ClampToEdgeWrapping;
+  const layers = jobs.map((j) => j.layer);
+  const textures: NaniteTextures = {
+    bark: barkTex,
+    leaf: leafTex,
+    barkLayerOf: layerLookup(layers),
+    leafLayerOf: layerLookup(layers),
+    // the demo's: under TAA (one sample) the leaves by coverage against a moving dither; with MSAA, alpha to coverage
+    alphaToCoverage: samples > 1,
+    leafDither: samples === 1 && LEAF_DITHER,
+  };
+  errors.sort((x, y) => x - y);
+  const mean = errors.reduce((s, e) => s + e, 0) / Math.max(1, errors.length);
+  return { types, instances: { a, b }, textures, barkLayers: layers, leafLayers: layers, residual: { mean, p90: errors[Math.floor(errors.length * 0.9)] ?? 0, lines }, growMs: performance.now() - t0 };
+}
diff --git a/examples/pgmaps/water.ts b/examples/pgmaps/water.ts
new file mode 100644
index 0000000..bf452f8
--- /dev/null
+++ b/examples/pgmaps/water.ts
@@ -0,0 +1,119 @@
+// The package's water (optional): each polygon a flat surface at its elevation (none given: the lowest ground on its
+// outer ring; terrain.ts works the levels out and lowers the ground under them), drawn as three's WebGPU WaterMesh draws water (three/addons/objects/WaterMesh.js: a planar reflection
+// through TSL's reflector(), rippled by a normal map, with Fresnel), its normal map made here (no image file). One
+// reflector per distinct level: its render is the scene again from below the surface (sky, ground, debris and the
+// stand's phase-1 clusters: what the eye saw last frame, which is what a lake mirrors).
+import * as THREE from 'three/webgpu';
+import {
+  Fn, add, cameraPosition, div, normalize, positionWorld, sub, time, texture, vec2, max, dot, reflect, pow, length, float,
+  uniform, reflector, mul, mix, vec3,
+} from 'three/tsl';
+import { makeFbm } from '../../src/ground/floor-maps.ts';
+import type { ScenePackage, Ring } from './package.ts';
+import type { Vec2, Vec3 } from '../../src/nanite-lib/index.ts';
+
+/** A tileable normal map from fractal noise (as the water's ripples): 256 texels, RepeatWrapping. */
+function rippleNormals(): THREE.DataTexture {
+  const N = 256, f = makeFbm(7, 8, 4), h = new Float32Array(N * N);
+  for (let y = 0; y < N; y++) for (let x = 0; x < N; x++) h[y * N + x] = f(x / N, y / N);
+  const px = new Uint8Array(N * N * 4);
+  for (let y = 0; y < N; y++)
+    for (let x = 0; x < N; x++) {
+      const dx = (h[y * N + ((x + 1) % N)] - h[y * N + ((x + N - 1) % N)]) * 18, dy = (h[((y + 1) % N) * N + x] - h[((y + N - 1) % N) * N + x]) * 18;
+      const l = Math.hypot(dx, dy, 1);
+      px.set([(-dx / l * 0.5 + 0.5) * 255, (-dy / l * 0.5 + 0.5) * 255, (1 / l * 0.5 + 0.5) * 255, 255], (y * N + x) * 4);
+    }
+  const t = new THREE.DataTexture(px, N, N);
+  t.wrapS = t.wrapT = THREE.RepeatWrapping;
+  t.magFilter = THREE.LinearFilter;
+  t.minFilter = THREE.LinearMipmapLinearFilter;
+  t.generateMipmaps = true;
+  t.needsUpdate = true;
+  return t;
+}
+
+export interface WaterInputs {
+  sunDir: THREE.Vector3;
+  sunColour: THREE.Color;
+}
+
+/** The water meshes (each at its level, on layer 0), or null when the package has none. */
+export function buildWater(scene: ScenePackage, levels: number[], o: WaterInputs): { group: THREE.Group; update: () => void } | null {
+  const bodies = (scene.water ?? []).filter((w) => Array.isArray(w?.rings) && w.rings[0]?.length >= 3);
+  if (!bodies.length) return null;
+  const normals = rippleNormals();
+  const byLevel = new Map<number, THREE.Shape[]>();
+  for (const [k, w] of bodies.entries()) {
+    const outer = w.rings[0];
+    const key = Math.round(levels[k] * 10) / 10; // (terrain.ts: the given level, or the lowest ground on the ring)
+    const toPath = <T extends THREE.Path>(r: Ring, path: T): T => {
+      r.forEach(([x, y], i) => (i ? path.lineTo(x, y) : path.moveTo(x, y)));
+      return path;
+    };
+    const shape = toPath(outer, new THREE.Shape());
+    for (const hole of w.rings.slice(1)) if (hole.length >= 3) shape.holes.push(toPath(hole, new THREE.Path()));
+    if (!byLevel.has(key)) byLevel.set(key, []);
+    byLevel.get(key)!.push(shape);
+  }
+  const group = new THREE.Group();
+  group.name = 'water';
+  const sunDirection = uniform(o.sunDir.clone()), sunColor = uniform(new THREE.Vector3(o.sunColour.r, o.sunColour.g, o.sunColour.b));
+  const deep = new THREE.Color(0x0d2a2a), waterColor = uniform(new THREE.Vector3(deep.r, deep.g, deep.b));
+  for (const [level, shapes] of byLevel) {
+    // (shape x east, y north; turned flat: local +z, the reflector's normal, up)
+    const geometry = new THREE.ShapeGeometry(shapes, 4);
+    const mesh = new THREE.Mesh(geometry, waterMaterial(normals, sunDirection, sunColor, waterColor, (m) => mesh.add(m)));
+    mesh.rotation.x = -Math.PI / 2;
+    mesh.position.y = level;
+    mesh.receiveShadow = true;
+    mesh.name = `water-${level}`;
+    // (layer 0, the first phase: its reflection's render then draws what that phase does, the stand's clusters seen
+    // last frame included. A reflector drawn in the second phase rendered black: none of the scene but a few leaves)
+    group.add(mesh);
+  }
+  return {
+    group,
+    update: () => {
+      sunDirection.value.copy(o.sunDir);
+      sunColor.value.set(o.sunColour.r, o.sunColour.g, o.sunColour.b);
+    },
+  };
+}
+
+/** WaterMesh's material (three/addons/objects/WaterMesh.js, MIT), with the normal map given and the reflector's target added by `adopt`. */
+function waterMaterial(normals: THREE.Texture, sunDirection: THREE.UniformNode<'vec3', THREE.Vector3>, sunColor: THREE.UniformNode<'vec3', THREE.Vector3>,
+  waterColor: THREE.UniformNode<'vec3', THREE.Vector3>, adopt: (o: THREE.Object3D) => void): THREE.NodeMaterial {
+  const material = new THREE.NodeMaterial(); // (unlit, as WaterMesh's: the light is in its colour)
+  const size = 1.4, distortionScale = 0.35; // (WaterMesh's 20 is for an ocean seen from hundreds of metres)
+  const waterNormals = texture(normals);
+  const sunC = sunColor, waterC = waterColor;
+  const noiseAt = (p: Vec2) => {
+    const uv0 = add(div(p, 103), vec2(div(time, 17), div(time, 29)));
+    const uv1 = div(p, 107).sub(vec2(div(time, -19), div(time, 31)));
+    const uv2 = add(div(p, vec2(897.0, 983.0)), vec2(div(time, 101), div(time, 97)));
+    const uv3 = sub(div(p, vec2(1091.0, 1027.0)), vec2(div(time, 109), div(time, -113)));
+    return waterNormals.sample(uv0).add(waterNormals.sample(uv1)).add(waterNormals.sample(uv2)).add(waterNormals.sample(uv3)).mul(0.5).sub(1);
+  };
+  const noise = noiseAt(positionWorld.xz.mul(size * 40));
+  const surfaceNormal = normalize(noise.xzy.mul(vec3(0.3, 1.0, 0.3))); // (a lake's ripples, not swell)
+  const worldToEye = cameraPosition.sub(positionWorld);
+  const eyeDirection = normalize(worldToEye);
+  const reflection = normalize(reflect(sunDirection.negate(), surfaceNormal));
+  const direction = max(0.0, dot(eyeDirection, reflection));
+  const specularLight = sunC.mul(pow(direction, 100)).mul(2.0);
+  const diffuseLight = sunC.mul(max(dot(sunDirection, surfaceNormal), 0.0)).mul(0.5);
+  const distance = length(worldToEye);
+  const distortion = surfaceNormal.xz.mul(float(0.001).add(float(1.0).div(distance))).mul(distortionScale);
+  material.colorNode = Fn(() => {
+    const mirror = reflector({ resolutionScale: 0.5 });
+    mirror.uvNode = mirror.uvNode!.add(distortion);
+    adopt(mirror.target);
+    const theta = max(dot(eyeDirection, surfaceNormal), 0.0);
+    const rf0 = float(0.02);
+    const reflectance = mul(pow(float(1.0).sub(theta), 5.0), float(1.0).sub(rf0)).add(rf0);
+    const scatter = waterC.mul(max(0.0, dot(surfaceNormal, eyeDirection)));
+    const base: Vec3 = diffuseLight.mul(0.3).add(scatter);
+    return base.mul(float(1).sub(reflectance)).add(mirror.rgb.add(specularLight).mul(reflectance));
+  })();
+  return material;
+}
