{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "rootDir": "src",
    "outDir": "dist",
    "types": [
      "geojson"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.*",
    "src/**/*.spec.*"
  ]
}
