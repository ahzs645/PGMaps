{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "crs",
    "inputs",
    "outputs",
    "method",
    "missing"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]*$"
    },
    "title": {
      "type": "string"
    },
    "crs": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "enum": [
              "number",
              "boolean"
            ]
          },
          "unit": {
            "type": "string"
          }
        }
      }
    },
    "method": {
      "type": "string"
    },
    "missing": {
      "type": "string"
    }
  }
}
