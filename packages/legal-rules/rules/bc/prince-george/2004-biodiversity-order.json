  "alternativesAndInterpretations": [
    {
      "id": "D.1",
      "kind": "eligible-contribution",
      "requiresReview": true,
      "summary": "Previously established OGMAs and new spatial old forest retention areas contribute; parks and protected areas may contribute."
    },
    {
      "id": "D.2",
      "kind": "combined-mbec-units",
      "requiresReview": true,
      "summary": "Certain similar mBEC units spanning forest district boundaries may use combined requirements."
    },
    {
      "id": "D.3",
      "kind": "epidemic-or-catastrophic",
      "requiresReview": true,
      "summary": "Representative affected stands may contribute; representative non-pine stands must be included."
    },
    {
      "id": "D.4",
      "kind": "younger-age-classes",
      "requiresReview": true,
      "maxPercentOfOldForestObjective": 20,
      "summary": "Up to 20% may be younger age classes only if equal or better conservation benefits are demonstrated."
    },
    {
      "id": "D.5(a)",
      "kind": "approved-recruitment-strategy",
      "requiresReview": true,
      "summary": "If old or interior old objective cannot be achieved, specified recruitment strategy requires approval."
    },
    {
      "id": "D.5(b)",
      "kind": "young-patch-rationale",
      "requiresReview": true,
      "summary": "If young patch distribution cannot be achieved, rationale with results or strategies must be submitted."
    }
  ],
  "implementationPolicy": {
    "sourceId": "bc.pgtsa.policy.2005",
    "legallyBinding": false,
